{
  "manifest_version": 3,
  "name": "Controle de Aula — Chromebook",
  "description": "O professor pareado abre/fecha abas, bloqueia sites, Shorts, Reels e IAs e vê as abas abertas. Cripto ponta a ponta.",
  "version": "0.6.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Controle de Aula",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "offscreen",
    "alarms",
    "wallpaper",
    "notifications",
    "browsingData",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "minimum_chrome_version": "133",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "filtros/comum.js",
        "filtros/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "filtros/comum.js",
        "filtros/instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://google.com/*",
        "*://www.google.com/*",
        "*://google.com.br/*",
        "*://www.google.com.br/*"
      ],
      "js": [
        "filtros/comum.js",
        "filtros/google.js"
      ],
      "run_at": "document_start"
    }
  ]
}
